{
  "name": "javascript-animation-engine",
  "version": "1.0.0",
  "description": "A framework-independent TypeScript animation engine.",
  "type": "module",
  "main": "./dist/javascript-animation-engine.umd.js",
  "module": "./dist/javascript-animation-engine.es.js",
  "browser": "./dist/javascript-animation-engine.umd.js",
  "exports": {
    ".": {
      "import": "./dist/javascript-animation-engine.es.js",
      "require": "./dist/javascript-animation-engine.umd.js",
      "default": "./dist/javascript-animation-engine.es.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rachanakotiyan/JavaScript-animation-engine.git"
  },
  "keywords": [],
