  "bugs": {
    "url": "https://github.com/rachanakotiyan/JavaScript-animation-engine/issues"
  },
  "homepage": "https://github.com/rachanakotiyan/JavaScript-animation-engine#readme",
  "dependencies": {
    "three": "^0.187.0"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vite": "^8.4.0"
  }
